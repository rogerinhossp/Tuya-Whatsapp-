# === Tuya Cloud ===
# Obtenha em: https://iot.tuya.com → Cloud → Project Management
TUYA_ACCESS_ID=seu_client_id_aqui
TUYA_ACCESS_SECRET=seu_client_secret_aqui
TUYA_REGION=us          # us | eu | cn | in | us-e | eu-w | sg
TUYA_DEVICE_ID=         # opcional - um device ID qualquer da sua conta (ajuda na autenticação)

# === Segurança do Bot ===
# Números autorizados (sem + e sem espaços). Ex: 5511999999999
ALLOWED_NUMBERS=5511999999999,5511888888888

# Prefixo dos comandos
PREFIX=!
